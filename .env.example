# ── Bartera Landing (Next.js) — environment ──────────────
# Copy to .env.local for local dev. On Vercel, set these in Project → Settings
# → Environment Variables (and for each branch you deploy).

# Google Analytics 4 measurement ID (starts with G-…).
# If unset, analytics is fully disabled — the site works identically.
NEXT_PUBLIC_GA_ID=

# Backend API base URL for the waitlist form.
# Defaults to https://api.bartera.in when unset.
NEXT_PUBLIC_API_URL=https://api.bartera.in

# Server-side override for the backend used by /privacy and /terms (ISR fetch
# of /api/v1/legal/{slug}). Falls back to NEXT_PUBLIC_API_URL.
# API_URL=https://api.bartera.in

# Store listing URLs. When set, App Store / Google Play badges replace the
# waitlist link in the footer. Leave empty until the listings are live.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Universal links / App Links (served from /.well-known/*).
# Apple Developer Team ID (defaults to the iosTeamId in mobile/app.json).
APPLE_TEAM_ID=
# SHA-256 signing cert fingerprint(s) from Play Console → App integrity,
# comma-separated, e.g. AA:BB:CC:...  Empty = assetlinks.json returns [].
ANDROID_SHA256_CERT=
